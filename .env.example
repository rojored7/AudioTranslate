# GitHub Personal Access Token con scope 'repo'
# Genera uno en: https://github.com/settings/tokens → New token → repo
GITHUB_TOKEN=ghp_your_token_here

# Repositorio donde se publican los Releases (puede ser el mismo repo del código)
# Formato: owner/repo  ej: miusuario/AudioTranslate
GITHUB_REPO=owner/repo

# URL de la API local de PC A (opcional, default: http://localhost:9001)
# LOCAL_API_URL=http://localhost:9001

# GitHub Personal Access Token con scope 'repo' (solo lectura es suficiente para PC B)
# Genera uno en: https://github.com/settings/tokens → New token → repo
GITHUB_TOKEN=ghp_your_token_here

# Repositorio donde PC A publica los Releases (debe coincidir con el de PC A)
GITHUB_REPO=owner/repo

# Cada cuántos minutos revisar GitHub por libros nuevos (default: 5)
# SYNC_INTERVAL_MINUTES=5

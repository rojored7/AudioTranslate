# Repositorio de GitHub donde PC A publica los Releases (igual que en PC A)
GITHUB_REPO=owner/repo

# Token SOLO si el repo es PRIVADO (los repos publicos no lo necesitan).
# Genera uno en: https://github.com/settings/tokens -> New token (classic) -> scope "repo"
# GITHUB_TOKEN=ghp_your_token_here

# Cada cuantos minutos revisar GitHub por libros nuevos (default: 5)
# SYNC_INTERVAL_MINUTES=5
